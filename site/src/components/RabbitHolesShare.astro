---
// SHARE LINKS (D21). Plain anchor hrefs to each platform's web intent endpoint —
// no third-party share widget, no SDK, no script from anyone else. A first-party
// "Copy link" button uses the Clipboard API.
//
// The Mastodon instance is the owner's (mastodon.social), matching the
// fediverse:creator handle in the base layout.
interface Props {
  /** The post title, woven into the share text. */
  title: string;
  /** The absolute canonical URL of the post. */
  url: string;
}

const { title, url } = Astro.props;
const text = encodeURIComponent(`${title} — ${url}`);
const bluesky = `https://bsky.app/intent/compose?text=${text}`;
const mastodon = `https://mastodon.social/share?text=${text}`;
const x = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
---

<nav class="share" aria-label="Share this post">
  <span class="share-label">Share:</span>
  <a class="share-link" href={bluesky} rel="noopener">Bluesky</a>
  <a class="share-link" href={mastodon} rel="noopener">Mastodon</a>
  <a class="share-link" href={x} rel="noopener">X</a>
  <button class="share-copy" type="button" data-copy-url={url}>Copy link</button>
</nav>

<script>
  // First-party only. Progressive enhancement: without JavaScript the button does
  // nothing and every other link still works. The URL travels in a data
  // attribute, so nothing is built from the page text at runtime.
  document.querySelectorAll<HTMLButtonElement>("button.share-copy").forEach((button) => {
    button.addEventListener("click", async () => {
      const url = button.dataset.copyUrl ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const original = button.textContent;
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = original;
        }, 1500);
      } catch {
        // Clipboard unavailable (insecure context, denied): leave the label.
      }
    });
  });
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .share-label {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .share-link {
    font-weight: 500;
  }

  .share-copy {
    font: inherit;
    font-weight: 500;
    color: var(--color-link);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
  }

  .share-copy:hover {
    text-decoration: underline;
  }
</style>
