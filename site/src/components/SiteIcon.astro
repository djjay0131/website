---
// Inline, in-repo SVG icons. No font, no sprite, no CDN (spec §4): the footer
// must load nothing off-origin, and a font icon would. `currentColor` lets the
// footer's link colour drive the icon in both themes.
interface Props {
  name: "github" | "linkedin" | "scholar" | "orcid" | "x" | "bluesky" | "rss" | "mail";
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  class="site-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role="img"
  aria-hidden="true"
  focusable="false"
  fill="currentColor"
>
  {name === "github" && (
    <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.2c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12v3.14c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
  )}
  {name === "linkedin" && (
    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM2.4 9.75h5.16V21H2.4V9.75Zm6.9 0h4.95v1.54h.07c.69-1.3 2.37-2.67 4.88-2.67 5.22 0 6.18 3.44 6.18 7.9V21h-5.16v-4.6c0-1.1-.02-2.5-1.53-2.5-1.53 0-1.76 1.2-1.76 2.42V21H9.3V9.75Z" />
  )}
  {name === "rss" && (
    <path d="M4 4a1 1 0 0 1 1 1 15 15 0 0 1 15 15 1 1 0 1 1-2 0A13 13 0 0 0 5 7a1 1 0 0 1-1-1Zm0 6a1 1 0 0 1 1 1 9 9 0 0 1 9 9 1 1 0 1 1-2 0 7 7 0 0 0-7-7 1 1 0 0 1-1-1Zm2.5 6.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z" />
  )}
  {name === "mail" && (
    <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.15L4.5 7v10h15V7L12 12.15ZM5.3 7l6.7 4.72L18.7 7H5.3Z" />
  )}
  {name === "scholar" && (
    <path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3ZM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82Z" />
  )}
  {name === "orcid" && (
    <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0ZM7.37 4.38c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947Zm-.723 3.04h1.444v10.04H6.647V7.42Zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.42Zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222Z" />
  )}
  {name === "x" && (
    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
  )}
  {name === "bluesky" && (
    <path d="M5.77 2.5C7.36 3.69 9.03 6.14 12 9.6c2.97-3.46 4.64-5.91 6.23-7.1C19.79 1.44 22 2.14 22 4.79c0 2.32-.55 7.93-.87 10.79-.65 5.42-3.02 6.53-5.13 3.37L12 12.94l-4 6.01c-2.11 3.16-4.48 2.05-5.13-3.37C2.55 12.72 2 7.11 2 4.79 2 2.14 4.21 1.44 5.77 2.5Z" />
  )}
</svg>

<style>
  .site-icon {
    display: inline-block;
    vertical-align: -0.15em;
    flex-shrink: 0;
  }
</style>
