---
// THE SHARED FOOTER (spec §4; ADR-0015 decision 5).
//
// Imported by BOTH src/layouts/Base.astro and
// src-private/layouts/PrivateBase.astro. Like SiteBand it carries NO navigation
// of its own: the three columns' links arrive as props, so the two builds keep
// their navigations separate while sharing the chrome.
//
// Icons are inline SVG from SiteIcon.astro: no icon font, no CDN, nothing
// off-origin (spec §4). Elsewhere links carry rel="me" (IndieWeb) and
// rel="noopener".
import SiteIcon from "./SiteIcon.astro";

interface FooterLink {
  label: string;
  /** Omitted means a non-link placeholder (e.g. RSS before Phase 6). */
  href?: string | null;
  external?: boolean;
}

interface ElsewhereLink {
  label: string;
  href: string;
  icon: "github" | "linkedin" | "scholar" | "orcid" | "x" | "bluesky" | "rss" | "mail";
}

interface Props {
  contact?: { email?: string; department?: string; university?: string };
  elsewhere?: ElsewhereLink[];
  nav?: FooterLink[];
  provenance?: string;
  buildInfo?: { short: string; href: string } | null;
  signInHref?: string | null;
  year?: number;
  footerLabel?: string;
}

const {
  contact = {},
  elsewhere = [],
  nav = [],
  provenance,
  buildInfo = null,
  signInHref = null,
  year = new Date().getFullYear(),
  footerLabel = "Site footer",
} = Astro.props;
---

<footer class="site-footer" role="contentinfo" aria-label={footerLabel}>
  <div class="footer-inner">
    <div class="footer-col">
      <h2 class="footer-heading">Jason Cusati</h2>
      {contact.department && <p>{contact.department}</p>}
      {contact.email && <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>}
      {signInHref && <p><a href={signInHref}>Sign in</a></p>}
    </div>

    <div class="footer-col">
      <h2 class="footer-heading">Elsewhere</h2>
      <ul class="footer-links">
        {elsewhere.map((entry) => (
          <li>
            <a href={entry.href} rel="me noopener">
              <SiteIcon name={entry.icon} />
              <span>{entry.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-heading">This site</h2>
      <ul class="footer-links">
        {nav.map((item) => (
          <li>
            {item.href ? (
              <a href={item.href} rel={item.external ? "noopener" : undefined}>{item.label}</a>
            ) : (
              <span class="footer-pending" title="Coming in a later phase">{item.label}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Jason Cusati</p>
    {provenance && <p class="footer-provenance">{provenance}</p>}
    {buildInfo && (
      <p class="footer-build">
        <a href={buildInfo.href}><code>{buildInfo.short}</code></a>
      </p>
    )}
  </div>
</footer>

<style>
  .site-footer {
    /* A maroon top rule on a --color-surface band (spec §4). The rule is the
       band maroon, not the theme-flipping accent. */
    background: var(--color-surface);
    border-top: 3px solid var(--color-band);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.875rem;
    margin-top: 3rem;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.75rem 1.5rem 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    border: none;
    padding: 0;
  }

  .footer-col p {
    margin-bottom: 0.25rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-link);
    font-weight: 500;
  }

  .footer-pending {
    color: var(--color-muted);
    opacity: 0.75;
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 1.5rem 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    align-items: baseline;
    font-size: 0.8rem;
  }

  .footer-provenance {
    flex: 1;
    min-width: 14rem;
  }

  .footer-build code {
    font-family: var(--font-mono);
  }

  @media (max-width: 600px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
