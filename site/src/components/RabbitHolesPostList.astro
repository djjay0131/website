---
// THE POST LIST (D21). One component for the index, tag pages and the archive:
// newest first, each entry a date, a linked title, the summary, its tags and a
// reading time. Reading time is computed from the Markdown body at build time.
import { readingLabel, tagSlug } from "../lib/rabbit-holes.mjs";

interface PostListItem {
  slug: string;
  title: string;
  date: Date;
  dateText: string;
  summary: string;
  tags: string[];
  body: string;
}

interface Props {
  posts: PostListItem[];
  /** Hide tag chips where the page itself is already a tag. */
  hideTags?: boolean;
}

const base = import.meta.env.BASE_URL;
const { posts, hideTags = false } = Astro.props;
---

<ul class="rh-list">
  {posts.map((post) => (
    <li class="rh-item">
      <article>
        <p class="rh-meta meta-mono">
          <time datetime={post.dateText}>{post.dateText}</time>
          <span aria-hidden="true"> · </span>
          <span>{readingLabel(post.body)}</span>
        </p>
        <h2 class="rh-title">
          <a href={`${base}rabbit-holes/${post.slug}/`}>{post.title}</a>
        </h2>
        {post.summary && <p class="rh-summary">{post.summary}</p>}
        {!hideTags && post.tags.length > 0 && (
          <ul class="rh-tags" aria-label="Tags">
            {post.tags.map((tag) => (
              <li>
                <a class="rh-tag" href={`${base}rabbit-holes/tags/${tagSlug(tag)}/`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )}
      </article>
    </li>
  ))}
</ul>

<style>
  .rh-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .rh-item {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .rh-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .rh-meta {
    margin-bottom: 0.2rem;
  }

  .rh-title {
    font-size: 1.35rem;
    margin: 0 0 0.35rem;
    border: none;
    padding: 0;
  }

  .rh-summary {
    color: var(--color-muted);
    margin-bottom: 0.5rem;
    max-width: 48rem;
  }

  .rh-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    font-size: 0.85rem;
  }

  .rh-tag {
    font-family: var(--font-mono);
    color: var(--color-link);
  }
</style>
