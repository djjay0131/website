---
// Site chrome: document head, shared band and footer, and the design tokens.
// Fonts are self-hosted from @fontsource packages; nothing loads from a CDN.
import "@fontsource/spectral/400.css";
import "@fontsource/spectral/400-italic.css";
import "@fontsource/spectral/600.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/tokens.css";
import SiteBand from "../components/SiteBand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { loadContentPool } from "../lib/cv-data";
import { CV_CONTENT_DIR } from "../lib/hub-content.mjs";
import { readFooterData, resolveElsewhere, readBuildInfo } from "../lib/footer.mjs";
import path from "node:path";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  /** Adds <meta name="robots" content="noindex">. */
  noindex?: boolean;
  /** Renders the band and footer without navigation (e.g. /signin/, spec §6). */
  hideNav?: boolean;
}

const {
  title,
  description = "Jason Cusati — Software Engineer, Researcher",
  ogImage,
  jsonLd,
  noindex = false,
  hideNav = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
// The default link-preview image is a generated card (name, title, maroon band,
// orange rule, no portrait). The portrait is never served on the public site
// (ADR-0015 decision 1); scripts/og-card.mjs generates this PNG at build time.
const ogImageUrl = ogImage ? `${siteUrl}${base}${ogImage}` : `${siteUrl}${base}og-card.png`;

// Footer and identity data (Amendment 3; spec §9). The handles come from
// cv-data's meta.contact, never hard-coded here.
const footer = readFooterData();
const meta = loadContentPool(path.resolve(CV_CONTENT_DIR)).meta;
const elsewhere = resolveElsewhere(footer, meta.contact);
const buildInfo = readBuildInfo(path.resolve("."), footer.repository);

// Public navigation. The phd section is never linked (brief §4).
const primaryNav = [
  { label: "Research", section: "research" },
  { label: "Projects", section: "projects" },
  { label: "Writing", section: "writing" },
  { label: "CV", section: "cv" },
];
const secondaryNav = [
  { label: "Papers", section: "papers" },
  { label: "Resumes", section: "resumes" },
];

const pathname = Astro.url.pathname;
const relativePath = pathname.startsWith(base) ? pathname.slice(base.length) : pathname.replace(/^\/+/, "");
const currentSection = relativePath.split("/")[0];
const navItems = (items: { label: string; section: string }[]) =>
  items.map((item) => ({
    label: item.label,
    href: `${base}${item.section}/`,
    current: currentSection === item.section,
  }));

// "This site" column (spec §4): nav plus Privacy, Email policy, an RSS
// placeholder (Phase 6) and the provenance link to the website repository.
const footerNav = [
  ...primaryNav.map((item) => ({ label: item.label, href: `${base}${item.section}/` })),
  ...secondaryNav.map((item) => ({ label: item.label, href: `${base}${item.section}/` })),
  { label: "RSS", href: null },
  { label: "Privacy", href: `${base}privacy/` },
  { label: "Email policy", href: `${base}email/` },
  { label: "Built from source", href: footer.repository, external: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD structured data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteBand
      homeHref={base}
      nav={hideNav ? [] : navItems(primaryNav)}
      secondaryNav={hideNav ? [] : navItems(secondaryNav)}
      wordmark={meta.name}
    />
    <main id="main-content" role="main">
      <slot />
    </main>
    <SiteFooter
      contact={{ email: meta.contact.email, department: footer.department, university: footer.university }}
      elsewhere={elsewhere}
      nav={footerNav}
      provenance={footer.provenance}
      buildInfo={buildInfo}
      signInHref={`${base}signin/`}
    />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    background: var(--color-bg);
  }

  body {
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    text-rendering: optimizeLegibility;
  }

  main {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    width: 100%;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  :focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  code, kbd, samp, pre {
    font-family: var(--font-mono);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .skip-link:focus {
    position: fixed;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    z-index: 1000;
    font-family: var(--font-body);
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.25;
  }

  h1 { font-size: 2.1rem; margin-bottom: 1rem; }
  h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid var(--color-accent);
  }
  h3 { font-size: 1.15rem; margin-top: 1rem; margin-bottom: 0.5rem; }

  /* Metadata: dates, counts, identifiers. */
  .meta-mono {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }

  @media print {
    .site-band, .site-footer, .skip-link { display: none; }
    main { max-width: 100%; padding: 0; }
    .print-banner { display: block !important; }
    a[href]::after { content: none; }
  }

  .print-banner {
    display: none;
    text-align: center;
    padding: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
  }
</style>
