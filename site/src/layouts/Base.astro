---
// Site chrome: document head, navigation, footer and the design tokens.
// Fonts are self-hosted from @fontsource packages; nothing loads from a CDN.
import "@fontsource/spectral/400.css";
import "@fontsource/spectral/400-italic.css";
import "@fontsource/spectral/600.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  /** Adds <meta name="robots" content="noindex">. */
  noindex?: boolean;
}

const {
  title,
  description = "Jason Cusati — Software Engineer, Researcher",
  ogImage,
  jsonLd,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
// Default link-preview image is the research emblem, not the portrait (owner decision, 2026-09-24).
const ogImageUrl = ogImage ? `${siteUrl}${base}${ogImage}` : `${siteUrl}${base}emblem/research-emblem.png`;

// Public navigation. The phd section is never linked (brief §4).
const primaryNav = [
  { label: "Research", section: "research" },
  { label: "Projects", section: "projects" },
  { label: "Writing", section: "writing" },
  { label: "CV", section: "cv" },
];
const secondaryNav = [
  { label: "Papers", section: "papers" },
  { label: "Resumes", section: "resumes" },
];

const pathname = Astro.url.pathname;
const relativePath = pathname.startsWith(base) ? pathname.slice(base.length) : pathname.replace(/^\/+/, "");
const currentSection = relativePath.split("/")[0];
const ariaCurrent = (section: string) =>
  currentSection !== section ? undefined : relativePath.replace(/\/$/, "") === section ? "page" : "true";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD structured data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="site-header" role="banner">
      <nav aria-label="Main navigation">
        <a href={base} class="nav-brand">Jason Cusati</a>
        <div class="nav-links">
          <ul class="nav-primary">
            {primaryNav.map((item) => (
              <li><a href={`${base}${item.section}/`} aria-current={ariaCurrent(item.section)}>{item.label}</a></li>
            ))}
          </ul>
          <ul class="nav-secondary">
            {secondaryNav.map((item) => (
              <li><a href={`${base}${item.section}/`} aria-current={ariaCurrent(item.section)}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>
    </header>
    <main id="main-content" role="main">
      <slot />
    </main>
    <footer class="site-footer" role="contentinfo">
      <p>&copy; {new Date().getFullYear()} Jason Cusati</p>
      {/* A members' area exists; this says nothing about what is in it. It names
          no item, no slug and no count, so it does not touch ADR-0005's guarantee
          that no public page lists, links or names a private item -- and the leak
          check still proves that on every build. /signin/ stays out of the
          sitemap and carries noindex (site-routes.mjs NOINDEX_SECTIONS), so this
          is a link for the two people who need it, not an invitation to crawlers.
          Deliberately in the footer rather than the main navigation: the owner
          chose the smallest disclosure that still makes it findable. */}
      <p class="footer-signin"><a href={`${base}signin/`}>Sign in</a></p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    background: var(--color-bg);
  }

  body {
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    text-rendering: optimizeLegibility;
  }

  main {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    width: 100%;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  :focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  code, kbd, samp, pre {
    font-family: var(--font-mono);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .skip-link:focus {
    position: fixed;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    z-index: 1000;
    font-family: var(--font-body);
  }

  .site-header {
    /* The VT two-colour band: maroon over orange in the light theme, and orange
       over maroon in dark, because --color-accent and --color-brand-rule swap
       with the theme (tokens.css). Both are VT primaries; which one leads is a
       legibility decision, since maroon is near-black on a dark ground.
       A box-shadow rather than a second element, so the markup is unchanged.
       Purely decorative, so it carries no text and needs no contrast guarantee --
       the AA checker governs text pairs only. */
    border-bottom: 3px solid var(--color-accent);
    box-shadow: 0 3px 0 var(--color-brand-rule);
    background: var(--color-bg);
  }

  .site-header nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: baseline;
  }

  .nav-brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--color-text);
  }

  .nav-brand:hover {
    color: var(--color-text);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    font-family: var(--font-body);
  }

  .nav-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0;
  }

  .nav-secondary {
    font-size: 0.9rem;
  }

  .nav-links a {
    color: var(--color-muted);
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--color-link);
  }

  .nav-links a[aria-current] {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    text-align: center;
    padding: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
    font-family: var(--font-body);
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.25;
  }

  h1 { font-size: 2.1rem; margin-bottom: 1rem; }
  h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid var(--color-accent);
  }
  h3 { font-size: 1.15rem; margin-top: 1rem; margin-bottom: 0.5rem; }

  /* Metadata: dates, counts, identifiers. */
  .meta-mono {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }

  @media (max-width: 600px) {
    .nav-secondary { font-size: 1rem; }
  }

  @media print {
    .site-header, .site-footer, .skip-link { display: none; }
    main { max-width: 100%; padding: 0; }
    .print-banner { display: block !important; }
    a[href]::after { content: none; }
  }

  .print-banner {
    display: none;
    text-align: center;
    padding: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
  }
</style>
