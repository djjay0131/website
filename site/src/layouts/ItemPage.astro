---
// One item: title, date and metadata, body, and a link back to its section.
import Base from "./Base.astro";

export interface ItemMetadata {
  label: string;
  value: string;
}

interface Props {
  /** The page heading. */
  title: string;
  /** The document <title>; defaults to "<title> — Jason Cusati". */
  pageTitle?: string;
  description?: string;
  /** ISO date. */
  date?: string;
  metadata?: ItemMetadata[];
  /** The section this item belongs to. */
  backHref: string;
  backLabel: string;
  noindex?: boolean;
}

const {
  title,
  pageTitle = `${title} — Jason Cusati`,
  description,
  date,
  metadata = [],
  backHref,
  backLabel,
  noindex = false,
} = Astro.props;
---

<Base title={pageTitle} description={description} noindex={noindex}>
  <article class="item-page">
    <p class="crumbs"><a href={backHref}>← {backLabel}</a></p>
    <header class="item-head">
      <h1>{title}</h1>
      {(date || metadata.length > 0) && (
        <dl class="item-meta meta-mono">
          {date && (
            <div><dt>Date</dt><dd><time datetime={date}>{date}</time></dd></div>
          )}
          {metadata.map((m) => (
            <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
          ))}
        </dl>
      )}
    </header>
    <div class="item-body">
      <slot />
    </div>
    <footer class="item-foot">
      <a href={backHref}>← Back to {backLabel}</a>
    </footer>
  </article>
</Base>

<style>
  .crumbs {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .item-head {
    margin-bottom: 1.25rem;
  }

  .item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .item-meta div {
    display: flex;
    gap: 0.4rem;
  }

  .item-meta dt {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .item-meta dd {
    margin: 0;
    color: var(--color-text);
  }

  .item-foot {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }
</style>
