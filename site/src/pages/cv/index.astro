---
import SectionIndex from "../../layouts/SectionIndex.astro";
import { loadVariantSummaries } from "../../lib/cv-data";
import { CV_VARIANTS_DIR, SOURCES_DIR } from "../../lib/hub-content.mjs";
import { collectPublicItems } from "../../lib/frame-content.mjs";
import path from "node:path";

// Synced from the content bucket (SEAM-5); the resolver is unchanged.
//
// The variant LIST is filtered by effective visibility (D8; SEAM-B3). `cv-data`
// carries every variant definition, including the private fellowship CV, so
// reading the variants directory directly would list it no matter what the
// manifest or the allowlist said. The allowlisted `cv` PDF items are the
// authority on which variants are public.
const visible = new Set(
  collectPublicItems(path.resolve(SOURCES_DIR), { section: "cv" }).map((i) => i.slug),
);
const variants = loadVariantSummaries(path.resolve(CV_VARIANTS_DIR)).filter((v) =>
  visible.has(v.slug),
);
const base = import.meta.env.BASE_URL;
const items = variants.map((v) => ({
  title: v.label,
  href: `${base}cv/${v.slug}`,
  summary: v.description || undefined,
  links: [
    { href: `${base}cv/${v.slug}`, label: "View on web" },
    { href: `${base}pdfs/${v.slug}.pdf`, label: "Download PDF" },
  ],
}));
---

<SectionIndex
  title="CV"
  description="Jason Cusati's CV in each of its variants, on the web and as PDF."
  lede="The CV in each of its variants, built from the same source. Read one on the web or download its PDF."
  items={items}
  emptyMessage="No CV variants are available in this build."
/>
