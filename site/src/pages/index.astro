---
import Base from "../layouts/Base.astro";
import { loadContentPool } from "../lib/cv-data";
import { CV_CONTENT_DIR } from "../lib/hub-content.mjs";
import path from "node:path";

// The CV payload now arrives from the content bucket through the publishing
// contract (SEAM-5). Only where the files are read from changed.
const pool = loadContentPool(path.resolve(CV_CONTENT_DIR));
const meta = pool.meta;
const summary = Object.values(pool.summaries)[0];
const base = import.meta.env.BASE_URL;
---

<Base title="Jason Cusati">
  <div class="hero">
    {/* The research emblem replaces the portrait (owner decision, 2026-09-24).
        It is an original SVG in the VT colour family: no university mark and
        no HokieBird, because the Office of Licensing and Trademarks declined
        the request to use them. Colours are not trademarks; the marks are. */}
    <img
      src={`${base}emblem/research-emblem.svg`}
      alt=""
      class="hero-emblem"
      width="200"
      height="200"
    />
    <div class="hero-text">
      <h1>{meta.name}</h1>
      <p class="subtitle">{summary?.text}</p>
      <div class="hero-links">
        <a href={`mailto:${meta.contact.email}`}>{meta.contact.email}</a>
        {meta.contact.github && (
          <a href={`https://github.com/${meta.contact.github}`}>GitHub</a>
        )}
        {meta.contact.linkedin && (
          <a href={`https://linkedin.com/in/${meta.contact.linkedin}`}>LinkedIn</a>
        )}
      </div>
      <div class="hero-actions">
        <a href={`${base}cv/academic`} class="btn btn-primary">View CV</a>
        <a href={`${base}pdfs/academic.pdf`} class="btn btn-secondary">Download PDF</a>
        <a href={`${base}papers`} class="btn btn-secondary">Papers</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .hero {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding: 2rem 0;
  }

  .hero-emblem {
    width: 200px;
    height: 200px;
    flex-shrink: 0;
  }

  .hero-text {
    flex: 1;
  }

  .subtitle {
    color: var(--color-muted);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-strong);
    color: var(--color-on-accent);
    text-decoration: none;
  }

  .btn-secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .hero {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .hero-links {
      justify-content: center;
    }

    .hero-actions {
      justify-content: center;
    }
  }
</style>
