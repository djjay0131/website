---
// RABBIT HOLES — one tag (D21). The URL is the tag's slug; the heading shows the
// tag as written. A tag with no posts is not generated.
import Base from "../../../layouts/Base.astro";
import RabbitHolesPostList from "../../../components/RabbitHolesPostList.astro";
import { getPublishedPosts } from "../../../lib/rabbit-holes-collection";
import { RABBIT_HOLES_TITLE, collectTags, tagSlug } from "../../../lib/rabbit-holes.mjs";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return collectTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag: tag.tag },
  }));
}

const base = import.meta.env.BASE_URL;
const posts = (await getPublishedPosts()).filter((post) =>
  post.tags.some((tag) => tagSlug(tag) === Astro.params.tag),
);
const heading = Astro.props.tag ?? Astro.params.tag;
---

<Base title={`#${heading} — ${RABBIT_HOLES_TITLE} — Jason Cusati`} description={`Rabbit Holes tagged #${heading}.`}>
  <p class="crumbs"><a href={`${base}rabbit-holes/tags/`}>← All tags</a></p>
  <header class="rh-head">
    <h1>#{heading}</h1>
    <p class="meta-mono">{posts.length} post{posts.length === 1 ? "" : "s"}</p>
  </header>
  <RabbitHolesPostList posts={posts} hideTags />
</Base>

<style>
  .crumbs {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .rh-head {
    margin-bottom: 1.5rem;
  }
</style>
