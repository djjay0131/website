---
// RABBIT HOLES — all tags (D21). Tags are free-form, so this is generated from
// whatever the published posts use; there is no taxonomy.
import Base from "../../../layouts/Base.astro";
import { getPublishedPosts } from "../../../lib/rabbit-holes-collection";
import { RABBIT_HOLES_TITLE, collectTags } from "../../../lib/rabbit-holes.mjs";

const base = import.meta.env.BASE_URL;
const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<Base title={`Tags — ${RABBIT_HOLES_TITLE} — Jason Cusati`} description={`All tags used in ${RABBIT_HOLES_TITLE}.`}>
  <p class="crumbs"><a href={`${base}rabbit-holes/`}>← {RABBIT_HOLES_TITLE}</a></p>
  <h1>Tags</h1>
  {tags.length > 0 ? (
    <ul class="tag-cloud">
      {tags.map((tag) => (
        <li>
          <a href={`${base}rabbit-holes/tags/${tag.slug}/`}>#{tag.tag}</a>
          <span class="tag-count meta-mono">{tag.count}</span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">No tags yet.</p>
  )}
</Base>

<style>
  .crumbs {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .tag-cloud {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .tag-cloud li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .tag-cloud a {
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .tag-count {
    color: var(--color-muted);
  }

  .empty {
    color: var(--color-muted);
  }
</style>
