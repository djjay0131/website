---
// RABBIT HOLES — the index (D21, Wave 8).
//
// Newest first, summary, date, tags and reading time. Pagination at PAGE_SIZE;
// page 1 is /rabbit-holes/, later pages are /rabbit-holes/page/<n>/ (the named
// /page/ path keeps the pagination URLs from colliding with post slugs).
import Base from "../../layouts/Base.astro";
import RabbitHolesPostList from "../../components/RabbitHolesPostList.astro";
import RabbitHolesSubscribe from "../../components/RabbitHolesSubscribe.astro";
import { getPublishedPosts } from "../../lib/rabbit-holes-collection";
import {
  PAGE_SIZE,
  RABBIT_HOLES_TITLE,
  RABBIT_HOLES_TAGLINE,
  pageCount,
} from "../../lib/rabbit-holes.mjs";

const base = import.meta.env.BASE_URL;
const posts = await getPublishedPosts();
const shown = posts.slice(0, PAGE_SIZE);
const totalPages = pageCount(posts.length, PAGE_SIZE);
const feed = (name: string) => `${base}rabbit-holes/${name}`;
---

<Base title={`${RABBIT_HOLES_TITLE} — Jason Cusati`} description={RABBIT_HOLES_TAGLINE}>
  <header class="rh-head">
    <h1>{RABBIT_HOLES_TITLE}</h1>
    <p class="rh-tagline">{RABBIT_HOLES_TAGLINE}</p>
    <nav class="rh-quick" aria-label="Rabbit Holes sections">
      <a href={`${base}rabbit-holes/archive/`}>Archive</a>
      <a href={`${base}rabbit-holes/tags/`}>Tags</a>
      <a href={feed("rss.xml")}>RSS</a>
      <a href={feed("index.json")}>JSON index</a>
    </nav>
  </header>

  {shown.length > 0 ? (
    <RabbitHolesPostList posts={shown} />
  ) : (
    <div class="rh-empty" role="status">
      <p class="rh-empty-title">Nothing here yet</p>
      <p>The first rabbit hole will appear here.</p>
    </div>
  )}

  {totalPages > 1 && (
    <nav class="rh-pager" aria-label="Pagination">
      <span />
      <a href={`${base}rabbit-holes/page/2/`}>Older →</a>
    </nav>
  )}

  <RabbitHolesSubscribe />
</Base>

<style>
  .rh-head {
    margin-bottom: 1.75rem;
  }

  .rh-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .rh-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .rh-empty {
    padding: 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .rh-empty-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .rh-pager {
    display: flex;
    justify-content: space-between;
    margin-top: 1.75rem;
    font-weight: 500;
  }
</style>
