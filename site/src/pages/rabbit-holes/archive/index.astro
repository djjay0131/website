---
// RABBIT HOLES — the archive, by month (D21). Every published post, grouped by
// its `YYYY-MM` month, newest first.
import Base from "../../../layouts/Base.astro";
import RabbitHolesPostList from "../../../components/RabbitHolesPostList.astro";
import { getPublishedPosts } from "../../../lib/rabbit-holes-collection";
import { RABBIT_HOLES_TITLE, groupByMonth } from "../../../lib/rabbit-holes.mjs";

const base = import.meta.env.BASE_URL;
const posts = await getPublishedPosts();
const months = groupByMonth(posts);
---

<Base title={`Archive — ${RABBIT_HOLES_TITLE} — Jason Cusati`} description={`Every ${RABBIT_HOLES_TITLE} post, by month.`}>
  <p class="crumbs"><a href={`${base}rabbit-holes/`}>← {RABBIT_HOLES_TITLE}</a></p>
  <h1>Archive</h1>
  {months.length > 0 ? (
    months.map((month) => (
      <section class="rh-month">
        <h2>{month.label}</h2>
        <RabbitHolesPostList posts={month.posts} />
      </section>
    ))
  ) : (
    <p class="empty">Nothing published yet.</p>
  )}
</Base>

<style>
  .crumbs {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .rh-month {
    margin-top: 2rem;
  }

  .empty {
    color: var(--color-muted);
  }
</style>
