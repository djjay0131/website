---
import ItemPage from "../../layouts/ItemPage.astro";
import { loadContentPool } from "../../lib/cv-data";
import { mdToHtml } from "../../lib/md";
import { CV_CONTENT_DIR } from "../../lib/hub-content.mjs";
import path from "node:path";

// Synced from the content bucket (SEAM-5); the resolver is unchanged.
export function getStaticPaths() {
  const pool = loadContentPool(path.resolve(CV_CONTENT_DIR));
  return Object.values(pool.projects).map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ItemPage
  title={project.name}
  pageTitle={`${project.name} — Jason Cusati`}
  description={project.summary}
  backHref={`${base}projects/`}
  backLabel="Projects"
>
  <p set:html={mdToHtml(project.summary)} />

  {project.github && (
    <p class="project-link">
      <a href={project.github} target="_blank" rel="noopener noreferrer">
        View on GitHub
      </a>
    </p>
  )}
</ItemPage>

<style>
  .project-link {
    margin-top: 1.5rem;
    font-family: var(--font-body);
  }

  .project-link a {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-weight: 500;
  }
</style>
