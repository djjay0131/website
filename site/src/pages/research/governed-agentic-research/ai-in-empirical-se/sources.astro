---
import Base from "../../../../layouts/Base.astro";
import SourceExplorer from "../../../../components/SourceExplorer.astro";
import sources from "../../../../data/governed-agentic-research/ai-in-empirical-se/sources.json";
const base = import.meta.env.BASE_URL;
const here = `${base}research/governed-agentic-research/ai-in-empirical-se/`;
const facets = [
  { key: "role", label: "AI role", get: (r: any) => (r.ai_role ?? [])[0] ?? null },
];
---

<Base
  annotatable
  title="Jason Cusati — AI across the Empirical-SE Lifecycle: Sources"
  description="Filterable explorer for the 219-record source dataset behind the digest on AI and agents across the empirical software engineering research lifecycle."
>
  <p class="crumbs"><a href={here}>← AI across the empirical-SE lifecycle</a></p>
  <h1>Source Explorer — AI across the Empirical-SE Lifecycle</h1>
  <p class="lede">{sources.length} records. The <em>category</em> filter is the lifecycle stage a record speaks to; <em>AI role</em> is the first role it assigns to the AI (tool call, assistant, autonomous agent, multi-agent, critic). The <em>via</em> column says which discovery channel found it; the <em>verified</em> column reflects the separate adversarial re-check — most records are still unchecked.</p>
  <SourceExplorer records={sources} facets={facets} />
</Base>

<style>
  .crumbs { font-size: 0.9rem; margin-bottom: 1rem; }
  .lede { color: var(--color-muted); margin-bottom: 1.25rem; }
</style>
