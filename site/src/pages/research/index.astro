---
// Research index, driven by site/src/data/research-portfolio.json (spec §2/§10;
// plan §11). The portfolio is the single source for the tenets, their standing
// questions and the projects beneath them, so the home page cards and this index
// cannot drift. Only `public` projects are listed; a project with no `href` is
// shown as text (a thread or a planned card) rather than linking to a 404.
import SectionIndex from "../../layouts/SectionIndex.astro";
import portfolio from "../../data/research-portfolio.json";

const base = import.meta.env.BASE_URL;

const items = portfolio.tenets.flatMap((tenet) =>
  tenet.projects
    .filter((project) => project.public)
    .map((project) => ({
      title: project.name,
      href: project.href ? `${base}${project.href.replace(/^\//, "")}` : undefined,
      meta: tenet.title,
      summary: project.goal ?? undefined,
    })),
);
---

<SectionIndex
  title="Research"
  pageTitle="Jason Cusati — Research"
  description="Research projects and digests from Jason Cusati's PhD work on knowledge graphs, agentic software engineering and AI safety."
  lede="Working projects grouped by the research question they answer. The digests carry a date and a method note and are regenerated from a research store in the project's repository."
  listTitle="Projects"
  items={items}
  emptyMessage="No research projects are listed yet."
/>
