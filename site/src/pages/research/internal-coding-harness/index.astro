---
// Project page for the internal agentic coding harness research. Projects three
// documents from the private repository djjay0131/internal-coding-harness, branch
// research/initial-synthesis at 198dfb5:
//   docs/research/2026-11-17-research-synthesis.md  -> synthesis/
//   docs/research/2026-11-17-summary.md (+ synthesis §5) -> summary/
//   llm/plans/2026-11-17-timeline-to-demo.md        -> plan/
// The rendered fragments live in src/data/internal-coding-harness/.
import Base from "../../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
const research = `${base}research/`;
const project = `${base}research/internal-coding-harness/`;
---

<Base
  annotatable
  title="Jason Cusati — Internal Agentic Coding Harness"
  description="Research on bringing an agentic coding tool in house at a large regulated enterprise: open harnesses, self-hosted open-weight models, routing, cost and governance."
>
  <p class="crumbs"><a href={research}>← Research</a></p>
  <h1>Internal Agentic Coding Harness</h1>
  <p class="subtitle">Self-hosted models, routing and governance for agentic coding</p>
  <p class="lede">
    What a large regulated enterprise needs to know before it brings an agentic
    coding tool in house and runs it against models it controls: industry
    practice, the academic literature, and the design guidance that follows from
    both.
  </p>

  <div class="cards">
    <a class="card" href={`${project}synthesis/`}>
      <span class="card-title">Research synthesis</span>
      <span class="card-desc">Options, industry practice, the academic evidence on harnesses, open-weight models, routing, self-hosting cost and security, and what to build.</span>
      <span class="card-meta">52 sources · 17 November 2026</span>
    </a>
    <a class="card" href={`${project}summary/`}>
      <span class="card-title">Summary and best practices</span>
      <span class="card-desc">The short version of the report, followed by the best-practice checklist.</span>
      <span class="card-meta">summary · 17 November 2026</span>
    </a>
    <a class="card" href={`${project}plan/`}>
      <span class="card-title">Plan: timeline to demo</span>
      <span class="card-desc">The three-day schedule from research to a working prototype, and the cut order if time runs short.</span>
      <span class="card-meta">plan · 17–19 November 2026</span>
    </a>
  </div>

  <h2>Status</h2>
  <p>
    The research synthesis, summary and timeline were written on 17 November
    2026. Nothing in the report has been measured yet; the
    prototype's evaluation is meant to supply the first numbers. The source
    repository is private.
  </p>
</Base>

<style>
  .crumbs { font-size: 0.9rem; margin-bottom: 1rem; }
  .lede { font-size: 1.1rem; color: var(--color-muted); margin-bottom: 1rem; }
  .subtitle { font-family: var(--font-body); color: var(--color-muted); margin: -0.5rem 0 1rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .card { display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 1.1rem; border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); border-radius: 4px; background: var(--color-surface); color: var(--color-text); text-decoration: none; }
  .card:hover { border-left-color: var(--color-link); text-decoration: none; }
  .card-title { font-family: var(--font-body); font-weight: 600; color: var(--color-link); font-size: 1.05rem; }
  .card-desc { font-size: 0.92rem; color: var(--color-muted); }
  .card-meta { font-family: var(--font-body); font-size: 0.78rem; color: var(--color-muted); margin-top: 0.25rem; }
</style>
