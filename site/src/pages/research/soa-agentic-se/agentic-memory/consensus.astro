---
import Base from "../../../../layouts/Base.astro";
import logs from "../../../../data/soa-agentic-se/agentic-memory/consensus.json";
const base = import.meta.env.BASE_URL;
const here = `${base}research/soa-agentic-se/agentic-memory/`;
---

<Base
  title="Jason Cusati — Agent Memory: Consensus Searches"
  description="The Consensus searches run for the agent-memory digest — sixty queries across four research passes — with the papers each surfaced."
>
  <p class="crumbs"><a href={here}>← Agent memory</a></p>
  <h1>Consensus Searches</h1>
  <p class="lede">Sixty queries run through the Consensus connector (search mode, no filters) on 14 September 2026, across four research passes. Each log lists the query and the papers it surfaced; every paper that became a record was then resolved to its primary page and re-checked. Filter <em>Found via → Consensus</em> in the <a href={`${here}sources/`}>source explorer</a> to see the resulting records.</p>
  <nav class="toc" aria-label="Logs"><ol>{logs.map((l) => <li><a href={`#${l.slug}`}>{l.label}</a></li>)}</ol></nav>
  {logs.map((l) => (
    <section class="log" id={l.slug}>
      <h2>{l.label}</h2>
      <div class="logbody" set:html={l.html} />
    </section>
  ))}
</Base>

<style is:global>
  .crumbs { font-size: 0.9rem; margin-bottom: 1rem; }
  .lede { color: var(--color-muted); margin-bottom: 1.25rem; }
  .toc { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 4px; padding: 0.75rem 1.25rem; margin-bottom: 1.5rem; font-family: var(--font-body); font-size: 0.9rem; }
  .toc ol { margin: 0 0 0 1.25rem; padding: 0; }
  .logbody { font-size: 0.92rem; }
  .logbody h2 { font-size: 1.15rem; border: none; margin-top: 1.5rem; }
  .logbody h3 { font-size: 1rem; }
  .logbody p { margin-bottom: 0.75rem; }
  .logbody ul, .logbody ol { margin: 0 0 0.9rem 1.4rem; }
  .logbody li { margin-bottom: 0.3rem; }
  .logbody table { border-collapse: collapse; font-family: var(--font-body); font-size: 0.82rem; margin: 0.75rem 0 1.25rem; display: block; overflow-x: auto; max-width: 100%; }
  .logbody th, .logbody td { border: 1px solid var(--color-border); padding: 0.35rem 0.5rem; text-align: left; vertical-align: top; }
  .logbody code { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-surface); padding: 0 0.2em; }
</style>
