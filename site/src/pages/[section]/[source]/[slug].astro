---
// One PUBLIC framed item, at /<section>/<source>/<slug>/ (Wave 1).
//
// `format: html` / `format: bundle` is "a self-contained page or folder, served
// verbatim in a thin frame with a back link" (docs/satellites.md). The frame is
// this page; the payload itself is staged byte-for-byte under
// /_payload/<source>/... by scripts/public-build.mjs, together with the sibling
// assets it loads, so its own relative links and stylesheet resolve exactly as
// they do in the satellite. This is the public twin of
// src-private/pages/[...itemPath].astro.
//
// Only the framed formats are routed here. `cv` is excluded: its PDFs and its
// data payload are rendered by first-party pages under /cv/ and /resumes/
// (ADR-0008), not by a frame. A manifest item in another format (pdf, data, md)
// has no frame and does not get a route -- the /projects/ index lists it without
// a link rather than linking to a 404.
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import AnnotationsMount from "../../../components/AnnotationsMount.astro";
import { payloadUrlFor } from "../../../lib/frame-content.mjs";

export async function getStaticPaths() {
  const framedFormats = new Set(["html", "bundle"]);
  const entries = await getCollection(
    "sources",
    ({ data }) =>
      data.effective_visibility === "public" &&
      data.source !== "cv" &&
      framedFormats.has(data.format),
  );

  return entries.map((entry) => ({
    params: {
      section: entry.data.section,
      source: entry.data.source,
      slug: entry.data.slug,
    },
    props: { item: entry.data },
  }));
}

const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
const payload = payloadUrlFor(item, base);
---

<Base
  title={`${item.title} — Jason Cusati`}
  description={item.summary}
>
  <article class="framed">
    <p class="crumbs"><a href={`${base}${item.section}/`}>← {item.section}</a></p>
    <h1>{item.title}</h1>
    <p class="meta">
      <time datetime={item.date}>{item.date}</time> · {item.source} · {item.format}
    </p>
    {item.summary && <p class="summary">{item.summary}</p>}

    <iframe class="payload" data-annotation-frame src={payload} title={item.title} loading="lazy"></iframe>
    <AnnotationsMount section={item.section} source={item.source} slug={item.slug} />
    <p class="fallback"><a href={payload}>Open this document on its own</a></p>
  </article>
</Base>

<style>
  .crumbs { font-size: 0.9rem; margin-bottom: 1rem; }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }
  .summary { color: var(--color-muted); margin-bottom: 1.5rem; }
  .payload {
    width: 100%;
    min-height: 70vh;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .fallback { margin-top: 0.75rem; font-size: 0.9rem; }
</style>
