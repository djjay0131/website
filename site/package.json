{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:local": "npm run data:link && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "data:link": "./scripts/sync-local-data.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:sync": "./scripts/sync-content.sh",
    "content:fixture": "./scripts/sync-content.sh --from fixtures/content",
    "data:fetch": "./scripts/fetch-data.sh",
    "redirects:generate": "node scripts/generate-redirect-map.mjs",
    "redirects:check": "node scripts/generate-redirect-map.mjs --check",
    "redirects:stubs": "node scripts/generate-redirect-stubs.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check:smoke-routes": "node scripts/check-smoke-routes.mjs",
    "build:public": "HUB_OUTPUT=public astro build",
    "build:private": "HUB_OUTPUT=private SITE_BASE=/p/ astro build",
    "search:index": "pagefind --site dist-public",
    "check:no-private-in-public": "node scripts/check-no-private-in-public.mjs --stubs dist-redirects",
    "check:publish-allowlist": "node scripts/check-publish-allowlist.mjs",
    "check:npm-audit": "node scripts/check-npm-audit.mjs",
    "check:private-links": "node scripts/check-private-links.mjs",
    "demo:leak-check": "node scripts/demo-leak-check.mjs",
    "sync:private": "node scripts/sync-private.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/react": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.2",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@types/js-yaml": "^4.0.9",
    "astro": "^7.3.3",
    "firebase": "^12.19.0",
    "js-yaml": "^4.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "pagefind": "^1.5.2"
  }
}
