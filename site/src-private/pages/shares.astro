---
// THE SHARES PAGE (SEAM-S6; contract site-wave-3 requirement 2; D24).
//
// Served by the gate at /p/shares/. Private build only. The page itself is
// static and reveals nothing: SharesIsland checks GET /share (owner only) and
// fetches /private/items for the mint form, so no item title is embedded in the
// HTML any member can download.
import PrivateBase from "../layouts/PrivateBase.astro";
import SharesIsland from "../components/SharesIsland.tsx";
---

<PrivateBase title="Shares">
  <h1>Shares</h1>
  <p class="lede">
    Choose an item to share for a bounded time. The link is a bearer
    credential: anyone who has it can read that item until it expires or you
    revoke it.
  </p>
  <SharesIsland client:load />
</PrivateBase>

<style>
  .lede { color: var(--color-muted); margin-bottom: 1.5rem; max-width: 60ch; }

  :global(.shares-island) { display: grid; gap: 2rem; }
  :global(.shares-island h2) { font-size: 1.2rem; margin-bottom: 0.5rem; }
  :global(.shares-note) { color: var(--color-muted); font-size: 0.9rem; }
  :global(.shares-island table) { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  :global(.shares-island th),
  :global(.shares-island td) {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  :global(.shares-island form) { display: grid; gap: 0.6rem; max-width: 28rem; }
  :global(.shares-island label) { display: grid; gap: 0.2rem; font-size: 0.9rem; }
  :global(.shares-island input),
  :global(.shares-island select) {
    font: inherit;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
  }
  :global(.shares-island button) {
    font: inherit;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    justify-self: start;
  }
  :global(.shares-island button:disabled) { opacity: 0.6; cursor: progress; }
  :global(.minted .link) { width: 100%; }
  :global(.visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
