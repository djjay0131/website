---
// ONE PROJECT SECTION (D25). The shell is member-readable; its page list comes
// from `/private/items`, so a member only sees pages they may open.
import { getCollection } from "astro:content";
import PrivateBase from "../../../layouts/PrivateBase.astro";
import RepositoryLink from "../../../components/RepositoryLink.astro";
import { isProjectItem, projectTitle } from "../../../lib/projects.mjs";

export async function getStaticPaths() {
  const all = (await getCollection("sources", ({ data }) => data.format !== "data")).map(
    (entry) => entry.data,
  );
  const privateItems = all.filter(
    (item) => item.effective_visibility === "private" && isProjectItem(item),
  );
  const bySource = new Map();
  for (const item of privateItems) {
    if (!bySource.has(item.source)) bySource.set(item.source, []);
    bySource.get(item.source).push(item);
  }
  return [...bySource.entries()].map(([source, items]) => ({
    params: { project: source },
    props: { source, title: projectTitle(items, source) },
  }));
}

const { source, title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<PrivateBase title={title}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href={`${base}projects/`}>Projects</a></li>
      <li data-parent-crumb hidden></li>
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <h1>{title}</h1>

  <RepositoryLink source={source} />

  <div
    id="project-pages"
    class="project-pages-root"
    data-source={source}
    data-base={base}
    data-title={title}
    aria-live="polite"
  >
    <p class="project-pages-note">Loading project pages…</p>
  </div>

  <div class="project-relations-root" data-project-relations hidden></div>

  <section class="project-hub-upcoming" data-project-upcoming aria-live="polite">
    <p class="project-pages-note">Loading deadlines…</p>
  </section>

  <script>
    import { loadPrivateItems } from "../../../lib/private-items.mjs";
    import {
      mountParentCrumb,
      mountProjectPages,
      mountProjectRelations,
      showProjectError,
    } from "../../../lib/project-ui.mjs";
    import { loadCalendar, mountProjectUpcoming } from "../../../lib/calendar-ui.mjs";

    const root = document.getElementById("project-pages");
    if (root) {
      const base = root.dataset.base ?? "/p/";
      const source = root.dataset.source ?? "";
      const title = root.dataset.title ?? "";
      const [result, calendar] = await Promise.all([loadPrivateItems(), loadCalendar()]);
      if (!result.ok) {
        showProjectError(root, "Could not load this project's pages. Try again shortly.");
      } else {
        mountProjectPages(root, result.items, source, base, title);
        const relations = document.querySelector<HTMLElement>("[data-project-relations]");
        if (relations) mountProjectRelations(relations, result.items, source);
        const crumb = document.querySelector<HTMLElement>("[data-parent-crumb]");
        if (crumb) mountParentCrumb(crumb, result.items, source);
      }
      const upcoming = document.querySelector<HTMLElement>("[data-project-upcoming]");
      if (upcoming && calendar.ok) {
        mountProjectUpcoming(upcoming, calendar.events, source);
      } else if (upcoming) {
        upcoming.replaceChildren();
      }
    }
  </script>
</PrivateBase>

<style>
  .breadcrumbs { font-size: 0.9rem; margin-bottom: 1.25rem; }
  .breadcrumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .breadcrumbs li + li::before { content: "›"; margin-right: 0.3rem; color: var(--color-muted); }
  .breadcrumbs [aria-current="page"] { color: var(--color-muted); }
  .breadcrumbs li[hidden] { display: none; }
  .project-pages-note { color: var(--color-muted); }
  .project-relations-root { margin-top: 1.5rem; display: grid; gap: 1.25rem; }
  .project-relations-root[hidden] { display: none; }
  .project-relations-root :global(.project-relations h2) { font-size: 1.1rem; margin: 0 0 0.6rem; }
  .project-relations-root :global(.project-relations-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.6rem;
  }
  .project-relations-root :global(.project-relations-list a) {
    display: block;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .project-pages-root :global(.project-pages) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .project-pages-root :global(.project-page-card) {
    padding: 1rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .project-pages-root :global(.project-page-title) { font-size: 1.15rem; margin: 0 0 0.2rem; }
  .project-pages-root :global(.project-page-meta) { color: var(--color-muted); margin: 0; font-size: 0.9rem; }
  .project-hub-upcoming {
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  .project-hub-upcoming :global(.project-upcoming-title) { font-size: 1.1rem; margin-bottom: 0.6rem; }
  .project-hub-upcoming :global(.calendar-upcoming-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  .project-hub-upcoming :global(.calendar-upcoming-item) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
    align-items: baseline;
    font-size: 0.92rem;
  }
  .project-hub-upcoming :global(.calendar-countdown) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent, #e6751f);
    min-width: 4.5rem;
  }
  .project-hub-upcoming :global(.calendar-when) { font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-muted); }
  .project-hub-upcoming :global(.calendar-note) { color: var(--color-muted); }
</style>
