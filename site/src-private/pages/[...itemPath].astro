---
// THE PRE-D25 ITEM ROUTE, KEPT WORKING (D25 / ADR-0026).
//
// /p/<section>/<source>/<slug>/ still resolves for every private item. Project
// items render the same inline project section as the new
// /p/projects/<source>/<slug>/ route; a non-project item (the private CV PDF)
// keeps its simple document page. No redirect is required, and the catalog maps
// both page objects to the item, so the access rule is identical.
import { getCollection } from "astro:content";
import PrivateBase from "../layouts/PrivateBase.astro";
import InlineItem from "../components/InlineItem.astro";
import { isProjectItem, projectPageHref } from "../lib/projects.mjs";

export async function getStaticPaths() {
  const all = (await getCollection("sources", ({ data }) => data.format !== "data")).map(
    (entry) => entry.data,
  );
  const privateItems = all.filter((item) => item.effective_visibility === "private");

  return privateItems.map((item) => ({
    params: { itemPath: `${item.section}/${item.source}/${item.slug}` },
    props: { item },
  }));
}

const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{isProjectItem(item) ? (
  // D32 / ADR-0029: the pre-D25 item route is retired. It is a static redirect
  // to the project route, reached only after the gate's item access decision.
  <PrivateBase title={item.title} redirectTo={projectPageHref(item, base)} />
) : (
  <PrivateBase title={item.title}>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={base}>Projects</a></li>
        <li aria-current="page">{item.title}</li>
      </ol>
    </nav>
    <div
      data-share-item
      data-section={item.section}
      data-source={item.source}
      data-slug={item.slug}
      data-entry={String(item.path ?? "").split("/").pop()}
      data-title={item.title}
    >
      <InlineItem item={item} base={base} />
    </div>
  </PrivateBase>
)}

<style>
  .breadcrumbs { font-size: 0.9rem; margin-bottom: 1.25rem; }
  .breadcrumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .breadcrumbs li + li::before { content: "›"; margin-right: 0.3rem; color: var(--color-muted); }
  .breadcrumbs [aria-current="page"] { color: var(--color-muted); }
</style>
