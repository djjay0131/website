---
// One private item, at /<section>/<source>/<slug>/.
//
// `format: html` is "a self-contained page or folder, served verbatim in a thin
// frame with a back link" (docs/satellites.md). The frame is this page; the
// payload itself is staged byte-for-byte under /_payload/<source>/... by
// scripts/private-build.mjs, together with the sibling assets it loads, so its
// own relative links and stylesheet resolve exactly as they do in the satellite.
import { getCollection } from "astro:content";
import PrivateBase from "../layouts/PrivateBase.astro";
import { memberHref, payloadUrlFor } from "../lib/private-content.mjs";
// The SHARED capture island (D20/Wave 7). It lives in the public srcDir so the
// public build can mount it too; the private build imports it across the
// one-way arrow (private -> public) that scripts/private-structure.test.ts pins.
import AnnotationsMount from "../../src/components/AnnotationsMount.astro";

export async function getStaticPaths() {
  // Only effectively-private items get a frame under /p/. The nav is built from
  // EVERY item (SEAM-B4: the member sees everything; public items link out).
  const all = (await getCollection("sources", ({ data }) => data.format !== "data")).map(
    (entry) => entry.data,
  );
  const privateItems = all.filter((item) => item.effective_visibility === "private");

  return privateItems.map((item) => ({
    params: { itemPath: `${item.section}/${item.source}/${item.slug}` },
    props: { item, all },
  }));
}

const { item, all } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.toString() ?? "";
const nav = all
  .slice()
  .sort((a, b) => (a.title < b.title ? -1 : 1))
  .map((i) => ({ href: memberHref(i, { base, site }), label: i.title }))
  .filter((n: { href: string | null; label: string }) => n.href !== null);
const payload = payloadUrlFor(item, base);
---

<PrivateBase title={item.title} nav={nav}>
  <p class="crumbs"><a href={base}>← Members' area</a></p>
  <h1>{item.title}</h1>
  <p class="meta">
    <time datetime={item.date}>{item.date}</time> · {item.source} · {item.format}
  </p>
  {item.summary && <p class="summary">{item.summary}</p>}

  {item.format === "html" || item.format === "bundle" ? (
    <>
      <iframe
        class="payload"
        data-annotation-frame
        src={payload}
        title={item.title}
        loading="lazy"></iframe>
      <AnnotationsMount section={item.section} source={item.source} slug={item.slug} />
      <p class="fallback"><a href={payload}>Open this document on its own</a></p>
    </>
  ) : (
    <p><a href={payload}>Open this document</a></p>
  )}
</PrivateBase>

<style>
  .crumbs { font-size: 0.9rem; margin-bottom: 1rem; }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }
  .summary { color: var(--color-muted); margin-bottom: 1.5rem; }
  .payload {
    width: 100%;
    min-height: 70vh;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .fallback { margin-top: 0.75rem; font-size: 0.9rem; }

  /* The capture island's own styles now ship with the SHARED component
     (src/components/AnnotationsMount.astro), so the private frame and the
     public item pages cannot drift. D20 moved the toolbar from a fixed bar at
     the bottom of the window to a selection-anchored popover. */
</style>
