---
// A PRIVATE-ONLY repository link (D27). The map is read at build time from the
// hub-side Terraform satellite config; the public build never imports this
// component. A satellite with no mapping renders nothing.
import { githubRepositoryUrl, repositoryFor, repositoryNoteFor } from "../lib/repositories.mjs";

interface Props {
  source: string;
  compact?: boolean;
}

const { source, compact = false } = Astro.props;
const repository = repositoryFor(source);
const url = githubRepositoryUrl(repository);
const note = repositoryNoteFor(source) ?? "Requires GitHub access to the repository.";
---

{url && (
  <div class:list={["repository-link", { "repository-link-compact": compact }]}>
    <a class="repository-link-anchor" href={url} target="_blank" rel="noopener noreferrer">
      <svg class="repository-link-icon" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
      </svg>
      <span class="repository-link-text">
        <span class="repository-link-label">Repository</span>
        <span class="repository-link-name">{repository}</span>
      </span>
    </a>
    <p class="repository-link-note">{note}</p>
  </div>
)}

<style>
  .repository-link {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .repository-link-compact { padding: 0.65rem 0.75rem; }
  .repository-link-anchor {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
  }
  .repository-link-anchor:hover { color: var(--color-link); }
  .repository-link-icon { flex: none; color: var(--color-muted); }
  .repository-link-text { display: grid; line-height: 1.25; min-width: 0; }
  .repository-link-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .repository-link-name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .repository-link-note {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.75rem;
  }
</style>
