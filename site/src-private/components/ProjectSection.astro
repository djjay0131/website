---
// A PROJECT SUB-PAGE (D25): breadcrumb, the inline document, and a sub-nav the
// viewer's own `/private/items` response fills. No item titles are embedded in
// the static HTML: a viewer who can open one page must not learn the others.
import { pageLabel, projectHref, projectTitle } from "../lib/projects.mjs";
import InlineItem from "./InlineItem.astro";
import RepositoryLink from "./RepositoryLink.astro";

interface Props {
  item: any;
  siblings: any[];
  base: string;
}

const { item, siblings, base } = Astro.props;
const title = projectTitle(siblings, item.source);
const label = pageLabel(item, title);
const projectUrl = projectHref(item, base);
const projectsUrl = `${base}projects/`;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href={projectsUrl}>Projects</a></li>
    <li><a href={projectUrl}>{title}</a></li>
    <li aria-current="page">{label}</li>
  </ol>
</nav>

<div class="project-layout">
  <div class="project-main">
    <InlineItem item={item} base={base} />
  </div>

  <aside class="project-sidebar" aria-label="Project navigation">
    <nav class="project-subnav" aria-labelledby="project-subnav-title">
      <p class="project-nav-title" id="project-subnav-title">In this project</p>
      <div data-project-nav aria-live="polite">
        <p class="project-nav-note">Loading project pages…</p>
      </div>
    </nav>
    <nav class="project-prevnext" data-project-prevnext aria-label="Previous and next pages"></nav>
    <section class="project-upcoming" data-project-upcoming aria-live="polite">
      <p class="project-nav-note">Loading deadlines…</p>
    </section>
    <RepositoryLink source={item.source} compact />
  </aside>
</div>

<script>
  import { loadPrivateItems } from "../lib/private-items.mjs";
  import { mountProjectNavigation, showProjectError } from "../lib/project-ui.mjs";
  import { loadCalendar, mountProjectUpcoming } from "../lib/calendar-ui.mjs";

  const navRoot = document.querySelector<HTMLElement>("[data-project-nav]");
  const prevRoot = document.querySelector<HTMLElement>("[data-project-prevnext]");
  const section = document.querySelector<HTMLElement>("[data-project-section]");
  const base = section?.dataset.base ?? "/p/";
  const source = section?.dataset.source ?? "";
  const slug = section?.dataset.slug ?? "";
  const title = section?.dataset.title ?? "";

  if (source && slug) {
    const [result, calendar] = await Promise.all([loadPrivateItems(), loadCalendar()]);
    if (!result.ok) {
      if (navRoot) showProjectError(navRoot, "Could not load the project pages. Try again shortly.");
    } else {
      mountProjectNavigation({ navRoot, prevRoot, items: result.items, source, slug, base, title });
    }
    const upcoming = document.querySelector<HTMLElement>("[data-project-upcoming]");
    if (upcoming && calendar.ok) {
      mountProjectUpcoming(upcoming, calendar.events, source);
    } else if (upcoming) {
      upcoming.replaceChildren();
    }
  }
</script>

<div
  data-project-section
  data-base={base}
  data-source={item.source}
  data-slug={item.slug}
  data-title={title}
  hidden></div>

<style>
  .breadcrumbs { font-size: 0.9rem; margin-bottom: 1.25rem; }
  .breadcrumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .breadcrumbs li + li::before { content: "›"; margin-right: 0.3rem; color: var(--color-muted); }
  .breadcrumbs [aria-current="page"] { color: var(--color-muted); }

  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: 2rem;
    align-items: start;
  }
  .project-main { min-width: 0; }
  .project-sidebar {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 1.25rem;
    font-size: 0.92rem;
  }
  .project-nav-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }
  .project-nav-note { color: var(--color-muted); }
  .project-subnav :global(.project-subnav-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }
  .project-subnav :global(.project-subnav-list a) {
    display: block;
    padding: 0.4rem 0.6rem;
    border-left: 3px solid transparent;
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .project-subnav :global(.project-subnav-list a[aria-current="page"]) {
    border-left-color: var(--rule-orange);
    background: var(--color-surface);
    font-weight: 600;
  }
  .project-prevnext {
    display: grid;
    gap: 0.6rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  .project-prevnext :global(a) {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .project-prevnext :global(.project-next) { text-align: right; }
  .project-upcoming {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  .project-upcoming :global(.project-upcoming-title) { font-size: 1rem; margin-bottom: 0.5rem; }
  .project-upcoming :global(.calendar-upcoming-list) { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .project-upcoming :global(.calendar-upcoming-item) { display: grid; gap: 0.15rem; font-size: 0.85rem; }
  .project-upcoming :global(.calendar-countdown) { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent, #e6751f); }
  .project-upcoming :global(.calendar-when) { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-muted); }
  .project-upcoming :global(.calendar-note) { color: var(--color-muted); font-size: 0.85rem; }
  .project-prevnext :global(.project-prev-label) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  @media (max-width: 52rem) {
    .project-layout { grid-template-columns: 1fr; }
    .project-sidebar { position: static; order: -1; }
  }
</style>
