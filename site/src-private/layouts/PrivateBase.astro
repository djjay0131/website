---
// Chrome for the private area. A deliberate sibling of src/layouts/Base.astro
// rather than a reuse of it, for one structural reason: Base.astro carries the
// PUBLIC navigation (Research, Projects, Writing, CV), and every one of those
// links 404s inside the private output, which is served by the gate from a
// separate bucket and contains none of those pages.
//
// Wave 0c (spec §7, ADR-0015 decision 5): the BAND and FOOTER are now shared
// components under src/components/, imported here and by Base.astro. Only the
// navigation differs, and it arrives as a prop, so no public nav reaches this
// build through the components.
//
// This file lives under src-private/, which the public build's srcDir never
// includes. Nothing here can reach dist-public.
import "@fontsource/spectral/400.css";
import "@fontsource/spectral/600.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../../src/styles/tokens.css";
import SiteBand from "../../src/components/SiteBand.astro";
import SiteFooter from "../../src/components/SiteFooter.astro";
import { loadContentPool } from "../../src/lib/cv-data";
import { CV_CONTENT_DIR } from "../../src/lib/hub-content.mjs";
import { readFooterData, resolveElsewhere, readBuildInfo } from "../../src/lib/footer.mjs";
import path from "node:path";

interface Props {
  title: string;
  /** Items in the private navigation: every private item this build rendered. */
  nav?: { href: string; label: string }[];
}

const { title, nav = [] } = Astro.props;

const base = import.meta.env.BASE_URL; // "/p/"
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const here = Astro.url.pathname;
// The Shares entry is added HERE, not by each page, so it appears on every
// /p/** page without touching any page or shared component (contract
// requirement 5). It is a private route under the base, so no public nav leaks.
const sharesHref = `${base}shares/`;
const bandNav = [
  ...nav.map((entry) => ({ ...entry, current: here === entry.href })),
  { href: sharesHref, label: "Shares", current: here === sharesHref },
];

const footer = readFooterData();
const meta = loadContentPool(path.resolve(CV_CONTENT_DIR)).meta;
const elsewhere = resolveElsewhere(footer, meta.contact);
const buildInfo = readBuildInfo(path.resolve("."), footer.repository);

// Public pages are reached by their CANONICAL public URL, not a /p/-relative
// link: the gate serves dist-private under /p/, and a bare /research/ would
// escape the base (check:private-links). An absolute outbound anchor is allowed
// by that check by design.
const canon = (rel: string) => (site ? `${site}/${rel}` : `/${rel}`);
const footerNav = [
  { label: "Research", href: canon("research/") },
  { label: "Projects", href: canon("projects/") },
  { label: "Writing", href: canon("writing/") },
  { label: "CV", href: canon("cv/") },
  { label: "Papers", href: canon("papers/") },
  { label: "Resumes", href: canon("resumes/") },
  { label: "RSS", href: null },
  { label: "Privacy", href: canon("privacy/") },
  { label: "Email policy", href: canon("email/") },
  { label: "Built from source", href: footer.repository, external: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Belt and braces. This output is served only by the gate, from a bucket
         no crawler can reach, but a private page must never be indexable even if
         it somehow escapes. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteBand
      homeHref={base}
      nav={bandNav}
      membersTag="Members"
      wordmark={meta.name}
      navLabel="Private navigation"
    >
      <!-- THE SIGN-OUT CONTROL (SD-4; finding B-8).
           A BUTTON, not a link: sign-out is a state change, so it is a POST.
           An <a href> or a GET here would be triggerable by an <img> tag on
           any page the member visits. The call itself lives in
           src-private/lib/signout.mjs, where its three security properties are
           pinned by tests rather than by review.
           It sits in the layout so that EVERY private page carries it -- a
           sign-out a member has to go looking for is one they will not use. -->
      <button slot="band-actions" id="sign-out" type="button" class="sign-out">Sign out</button>
    </SiteBand>

    <!-- A failed sign-out must be SEEN. A member who believes they signed out
         and did not is worse off than one who sees an error. -->
    <p id="sign-out-error" class="sign-out-error" role="alert" hidden></p>

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter
      contact={{ email: meta.contact.email, department: footer.department, university: footer.university }}
      elsewhere={elsewhere}
      nav={footerNav}
      provenance={footer.provenance}
      buildInfo={buildInfo}
      signInHref={canon("signin/")}
    />

    <script>
      // Capture what the members' area would otherwise swallow.
      //
      // DELIBERATELY NOT IN Base.astro. That layout has no client script at all,
      // and adding one would ship this module to every public page -- including
      // the CV -- on a site that is otherwise almost JavaScript-free and
      // self-hosts everything it loads. Beaconing a public visitor's browser
      // errors is a different thing from diagnosing the owner's own members'
      // area, and only the second was asked for.
      //
      // /signin/ installs it separately, because that is where sign-in fails.
      const { installGlobalHandlers, recordEvent } = await import("../../src/lib/client-events.mjs");
      installGlobalHandlers();

      // SIGN-OUT (SD-4; B-8). The gate has owned this route, and firebase.json
      // its rewrite, since Wave 0 -- with no caller anywhere in site/. This is
      // the caller. The endpoint and the request shape are NOT spelled here:
      // they belong to signout.mjs, so there is one copy of them and a test can
      // assert it.
      const { signOut } = await import("../lib/signout.mjs");
      const signOutButton = document.getElementById("sign-out") as HTMLButtonElement | null;
      const signOutError = document.getElementById("sign-out-error");

      signOutButton?.addEventListener("click", async () => {
        signOutButton.disabled = true;
        if (signOutError) {
          signOutError.textContent = "";
          signOutError.hidden = true;
        }

        const outcome = await signOut({
          onFailure: (message) => {
            if (!signOutError) return;
            signOutError.textContent = message;
            signOutError.hidden = false;
          },
        });

        // On success the browser is already navigating away. On failure the
        // member stays here, sees why, and can try again -- and the gate hears
        // about it in the same event grammar sign-in failures use.
        if (!outcome.ok) {
          signOutButton.disabled = false;
          recordEvent(
            "signout_failed",
            { reason: outcome.reason, http_status: outcome.status ?? 0 },
            { immediate: true },
          );
        }
      });
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; }
  html { background: var(--color-bg); }
  body {
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    width: 100%;
  }
  a { color: var(--color-link); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 600; line-height: 1.25; }
  h1 { font-size: 2rem; margin-bottom: 1rem; }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .skip-link:focus {
    position: fixed;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    background: var(--color-on-band);
    color: var(--color-band);
    z-index: 1000;
    font-family: var(--font-body);
  }

  .sign-out {
    font-family: var(--font-body);
    font-size: 0.8rem;
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--color-on-band);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-on-band);
    cursor: pointer;
  }
  .sign-out:hover { background: rgba(255, 255, 255, 0.12); }
  .sign-out:focus-visible { outline: 2px solid var(--rule-orange); outline-offset: 2px; }
  .sign-out[disabled] { opacity: 0.6; cursor: progress; }
  .sign-out-error {
    max-width: var(--max-width);
    margin: 0.5rem auto 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-risk);
    border-radius: var(--radius);
    background: var(--color-risk-bg);
    color: var(--color-text);
    font-size: 0.85rem;
  }

  /* The public layout hides the chrome when printing; the private one must too
     (a11y Wave 0c, check 7). The band, footer and skip link are navigation, not
     content, and the sign-out control is meaningless on paper. */
  @media print {
    .site-band, .site-footer, .skip-link { display: none; }
    main { max-width: 100%; padding: 0; }
    a[href]::after { content: none; }
  }
</style>
