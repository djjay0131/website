---
// Chrome for the private area. A deliberate sibling of src/layouts/Base.astro
// rather than a reuse of it, for one structural reason: Base.astro carries the
// PUBLIC navigation (Research, Projects, Writing, CV), and every one of those
// links 404s inside the private output, which is served by the gate from a
// separate bucket and contains none of those pages.
//
// This file lives under src-private/, which the public build's srcDir never
// includes. Nothing here can reach dist-public.
import "@fontsource/spectral/400.css";
import "@fontsource/spectral/600.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../../src/styles/tokens.css";

interface Props {
  title: string;
  /** Items in the private navigation: every private item this build rendered. */
  nav?: { href: string; label: string }[];
}

const { title, nav = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Belt and braces. This output is served only by the gate, from a bucket
         no crawler can reach, but a private page must never be indexable even if
         it somehow escapes. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title}</title>
  </head>
  <body>
    <header class="private-header">
      <p class="badge">Private · shared with you</p>
      <nav aria-label="Private navigation">
        <a href={import.meta.env.BASE_URL} class="brand">Members' area</a>
        {nav.length > 0 && (
          <ul>
            {nav.map((entry) => (
              <li><a href={entry.href}>{entry.label}</a></li>
            ))}
          </ul>
        )}
        <!-- THE SIGN-OUT CONTROL (SD-4; finding B-8).
             A BUTTON, not a link: sign-out is a state change, so it is a POST.
             An <a href> or a GET here would be triggerable by an <img> tag on
             any page the member visits. The call itself lives in
             src-private/lib/signout.mjs, where its three security properties are
             pinned by tests rather than by review.
             It sits in the layout so that EVERY private page carries it -- a
             sign-out a member has to go looking for is one they will not use. -->
        <button id="sign-out" type="button" class="sign-out">Sign out</button>
      </nav>
      <!-- A failed sign-out must be SEEN. A member who believes they signed out
           and did not is worse off than one who sees an error. -->
      <p id="sign-out-error" class="sign-out-error" role="alert" hidden></p>
    </header>
    <main>
      <slot />
    </main>
    <footer class="private-footer">
      <p>Not for redistribution.</p>
    </footer>
  
    <script>
      // Capture what the members' area would otherwise swallow.
      //
      // DELIBERATELY NOT IN Base.astro. That layout has no client script at all,
      // and adding one would ship this module to every public page -- including
      // the CV -- on a site that is otherwise almost JavaScript-free and
      // self-hosts everything it loads. Beaconing a public visitor's browser
      // errors is a different thing from diagnosing the owner's own members'
      // area, and only the second was asked for.
      //
      // /signin/ installs it separately, because that is where sign-in fails.
      const { installGlobalHandlers, recordEvent } = await import("../../src/lib/client-events.mjs");
      installGlobalHandlers();

      // SIGN-OUT (SD-4; B-8). The gate has owned this route, and firebase.json
      // its rewrite, since Wave 0 -- with no caller anywhere in site/. This is
      // the caller. The endpoint and the request shape are NOT spelled here:
      // they belong to signout.mjs, so there is one copy of them and a test can
      // assert it.
      const { signOut } = await import("../lib/signout.mjs");
      const signOutButton = document.getElementById("sign-out") as HTMLButtonElement | null;
      const signOutError = document.getElementById("sign-out-error");

      signOutButton?.addEventListener("click", async () => {
        signOutButton.disabled = true;
        if (signOutError) {
          signOutError.textContent = "";
          signOutError.hidden = true;
        }

        const outcome = await signOut({
          onFailure: (message) => {
            if (!signOutError) return;
            signOutError.textContent = message;
            signOutError.hidden = false;
          },
        });

        // On success the browser is already navigating away. On failure the
        // member stays here, sees why, and can try again -- and the gate hears
        // about it in the same event grammar sign-in failures use.
        if (!outcome.ok) {
          signOutButton.disabled = false;
          recordEvent(
            "signout_failed",
            { reason: outcome.reason, http_status: outcome.status ?? 0 },
            { immediate: true },
          );
        }
      });
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; }
  html { background: var(--color-bg); }
  body {
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    width: 100%;
  }
  a { color: var(--color-link); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 600; line-height: 1.25; }
  h1 { font-size: 2rem; margin-bottom: 1rem; }

  .private-header {
    border-bottom: 3px solid var(--color-accent);
    padding: 1rem 1.5rem;
  }
  .private-header nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .private-header ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--color-text);
  }
  .sign-out {
    margin-left: auto;
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  .sign-out:hover { border-color: var(--color-accent); }
  .sign-out:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .sign-out[disabled] { opacity: 0.6; cursor: progress; }
  .sign-out-error {
    max-width: var(--max-width);
    margin: 0.5rem auto 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-risk);
    border-radius: var(--radius);
    background: var(--color-risk-bg);
    color: var(--color-text);
    font-size: 0.85rem;
  }
  .badge {
    max-width: var(--max-width);
    margin: 0 auto 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .private-footer {
    border-top: 1px solid var(--color-border);
    text-align: center;
    padding: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
