---
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base
  title="Jason Cusati — Fellowship Team Research Notes"
  description="Notes on Anthropic research directions from Jason Cusati's Fellows 2026 sprint."
>
  <p class="crumbs"><a href={`${base}fellowship-sprint/`}>← Fellowship sprint</a></p>

  <h1>Team Research Notes</h1>
  <p class="lede">
    Short write-ups on the Anthropic research directions I'm most drawn to,
    grounded in specific work I've read. Aim: enough intellectual traction to
    write an honest, specific answer to the application's "current research
    interests" question — no more.
  </p>

  <p class="framing">
    Streams I'm applying to (primary + secondaries) are the organizing
    structure. Each entry names the direction, cites one or two specific
    pieces of work, and states what I find compelling and what I don't yet
    understand.
  </p>

  <p class="empty-note">
    No entries yet — writing starts Day 3 (2026-07-20).
  </p>
</Base>

<style>
  .crumbs {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .lede {
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .framing {
    color: var(--color-muted);
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .empty-note {
    padding: 2rem;
    background: var(--color-surface);
    border-radius: 4px;
    color: var(--color-muted);
    font-style: italic;
    text-align: center;
  }
</style>
