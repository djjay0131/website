---
import Base from "../../../layouts/Base.astro";
import queries from "../../../data/agentic-harnesses/consensus.json";

const base = import.meta.env.BASE_URL;
const titles: Record<string, string> = {
  "q1-attribution": "Scaffold vs. model attribution",
  "q2-aci-tools": "Agent-computer interface and tool design",
  "q3-benchmark-validity": "Benchmark validity, contamination, variance",
  "q4-multi-agent": "Multi-agent vs. single-agent",
  "q5-context-management": "Context management and compaction",
  "q6-sandbox-safety": "Sandboxing, permissions, oversight",
  "q7-field-studies": "Field studies of developers using agents",
  "q8-taxonomy": "Taxonomy of harness architectures",
};
---

<Base
  title="Jason Cusati — Agentic Harnesses: Consensus Searches"
  description="The eight Consensus Deep searches run for the agentic-harnesses digest, with their generated syntheses and cited papers."
>
  <p class="crumbs"><a href={`${base}research/agentic-harnesses/`}>← Agentic harnesses</a></p>
  <h1>Consensus Deep Searches</h1>
  <p class="lede">
    Eight queries run on consensus.app (Pro, "Deep" mode) on 10 September
    2026. Each search reads roughly twenty abstracts and PDFs and writes a
    cited synthesis. The text below is Consensus's own output, kept as a
    lead-finder; every cited paper was then resolved to its primary page and
    recorded in the <a href={`${base}research/agentic-harnesses/sources/`}>source explorer</a>
    (filter <em>Found via → Consensus</em>). 105 of the 268 records came only
    from these searches; 29 more were independently re-surfaced.
  </p>

  <nav class="toc" aria-label="Queries">
    <ol>
      {queries.map((q) => <li><a href={`#${q.slug}`}>{q.label} — {titles[q.slug] ?? q.query}</a></li>)}
    </ol>
  </nav>

  {queries.map((q) => (
    <section class="query" id={q.slug}>
      <h2>{q.label} — {titles[q.slug] ?? q.query}</h2>
      <p class="qmeta">
        Query: <em>{q.query}</em> · <a href={q.url} target="_blank" rel="noopener noreferrer">open on consensus.app ↗</a>
      </p>
      <div class="synth" set:html={q.synthesis_html} />
      <details>
        <summary>Papers cited by this search</summary>
        <div class="cited" set:html={q.cited_html} />
      </details>
    </section>
  ))}
</Base>

<style is:global>
  .crumbs { font-size: 0.9rem; margin-bottom: 1rem; }
  .lede { color: var(--color-muted); margin-bottom: 1.25rem; }
  .toc { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 4px; padding: 0.75rem 1.25rem; margin-bottom: 1.5rem; font-family: var(--font-sans); font-size: 0.9rem; }
  .toc ol { margin: 0 0 0 1.25rem; padding: 0; }
  .qmeta { font-family: var(--font-sans); font-size: 0.85rem; color: var(--color-muted); margin-bottom: 0.75rem; }
  .synth p { margin-bottom: 0.9rem; }
  .synth strong { font-family: var(--font-sans); }
  details { margin: 0.5rem 0 1.5rem; font-family: var(--font-sans); font-size: 0.85rem; }
  summary { cursor: pointer; color: var(--color-primary); }
  .cited ul { margin: 0.5rem 0 0 1.25rem; }
  .cited li { font-family: var(--font-mono); font-size: 0.78rem; margin-bottom: 0.2rem; }
</style>
