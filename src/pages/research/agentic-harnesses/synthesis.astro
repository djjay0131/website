---
import Base from "../../../layouts/Base.astro";
import synthesisHtml from "../../../data/agentic-harnesses/synthesis.html?raw";

const base = import.meta.env.BASE_URL;

// Build a table of contents from the h2 headings in the rendered synthesis
// and give each heading an id so the TOC can link to it.
const toc: { id: string; text: string }[] = [];
const html = synthesisHtml.replace(/<h2>(.*?)<\/h2>/g, (_m, text: string) => {
  const plain = text.replace(/<[^>]+>/g, "");
  const id = plain
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
  toc.push({ id, text: plain });
  return `<h2 id="${id}">${text}</h2>`;
});
---

<Base
  title="Jason Cusati — Agentic Harnesses: Synthesis"
  description="Synthesis of the state of the art on coding-agent harnesses: taxonomy, design space, industry landscape, evaluation validity, and the model-vs-harness attribution evidence (September 2026)."
>
  <p class="crumbs"><a href={`${base}research/agentic-harnesses/`}>← Agentic harnesses</a></p>

  <h1>Agentic Harnesses for Coding Agents: State of the Art</h1>
  <p class="meta">
    Research digest, 10 September 2026. Bracketed tokens are source ids; each
    links to its record in the <a href={`${base}research/agentic-harnesses/sources/`}>source explorer</a>.
  </p>

  <nav class="toc" aria-label="Contents">
    <strong>Contents</strong>
    <ol>
      {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
    </ol>
  </nav>

  <article class="synthesis" set:html={html} />
</Base>

<style is:global>
  .crumbs { font-size: 0.9rem; margin-bottom: 1rem; }
  .meta { color: var(--color-muted); font-family: var(--font-sans); font-size: 0.9rem; margin-bottom: 1.5rem; }
  .toc { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 4px; padding: 1rem 1.25rem; margin-bottom: 2rem; font-family: var(--font-sans); font-size: 0.9rem; }
  .toc ol { margin: 0.5rem 0 0 1.25rem; padding: 0; }
  .toc li { margin: 0.2rem 0; }
  .synthesis p { margin-bottom: 1rem; }
  .synthesis ul, .synthesis ol { margin: 0 0 1rem 1.5rem; }
  .synthesis li { margin-bottom: 0.4rem; }
  .synthesis h3 { margin-top: 1.5rem; }
  .synthesis hr { border: 0; border-top: 1px solid var(--color-border); margin: 2rem 0; }
  .synthesis code { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-surface); padding: 0 0.25em; }
  .synthesis a.cite { font-family: var(--font-mono); font-size: 0.78em; color: var(--color-accent); overflow-wrap: anywhere; }
  .synthesis a.cite:hover { color: var(--color-primary); }
  .synthesis .table-wrap, .synthesis table { max-width: 100%; }
  .synthesis table { border-collapse: collapse; font-family: var(--font-sans); font-size: 0.85rem; margin: 1rem 0 1.5rem; display: block; overflow-x: auto; }
  .synthesis th, .synthesis td { border: 1px solid var(--color-border); padding: 0.4rem 0.5rem; text-align: left; vertical-align: top; }
  .synthesis th { background: var(--color-surface); }
</style>
