---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---

<Base
  title="Jason Cusati — Research"
  description="Research digests and source explorers from Jason Cusati's PhD work on agentic software engineering."
>
  <h1>Research</h1>
  <p class="lede">
    Working digests from my PhD research, grouped by project. Each digest is a
    synthesized state-of-the-art read on one question, backed by a source
    dataset you can filter and trace. They carry a date and a method note and
    are regenerated from a research store in the project's repository.
  </p>

  <h2>Projects</h2>
  <ul class="section-list">
    <li>
      <a href={`${base}research/soa-agentic-se/`}>State of the Art in Agentic Software Engineering</a>
      <span class="section-meta">
        — a paper project mapping what the field has built against what it has
        measured. Two research tracks so far: agentic harnesses and agent memory.
      </span>
    </li>
  </ul>
</Base>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); margin-bottom: 1.5rem; }
  .section-list { list-style: none; padding: 0; }
  .section-list li { padding: 0.75rem 0; border-bottom: 1px solid var(--color-border); }
  .section-list li:last-child { border-bottom: none; }
  .section-list a { font-weight: 600; color: var(--color-primary); }
  .section-meta { color: var(--color-muted); font-size: 0.95rem; }
</style>
