{
  "hosting": {
    "public": "site/dist-public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "cleanUrls": false,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/p/**",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/session",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/session/end",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/client-events",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/share",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/share/**",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/s/**",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      }
    ],
    "redirects": [
      {
        "source": "/pdfs/anthropic-fellow.pdf",
        "destination": "/signin/",
        "type": 302
      },
      {
        "source": "/cv/anthropic-fellow",
        "destination": "/signin/",
        "type": 302
      },
      {
        "source": "/cv/anthropic-fellow/**",
        "destination": "/signin/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
