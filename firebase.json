{
  "hosting": {
    "public": "site/dist-public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "cleanUrls": false,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/p/**",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/session",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/session/end",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/client-events",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/share",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/share/**",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/s/**",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/annotations",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      },
      {
        "source": "/annotations/**",
        "run": {
          "serviceId": "hub-gate",
          "region": "us-east1"
        }
      }
    ],
    "redirects": [
      {
        "source": "/pdfs/anthropic-fellow.pdf",
        "destination": "/signin/",
        "type": 302
      },
      {
        "source": "/cv/anthropic-fellow",
        "destination": "/signin/",
        "type": 302
      },
      {
        "source": "/cv/anthropic-fellow/**",
        "destination": "/signin/",
        "type": 302
      },
      {
        "source": "/resumes",
        "destination": "/cv/",
        "type": 301
      },
      {
        "source": "/resumes/",
        "destination": "/cv/",
        "type": 301
      },
      {
        "source": "/resumes/**",
        "destination": "/cv/",
        "type": 301
      },
      {
        "source": "/cv/academic",
        "destination": "/cv/research-full",
        "type": 301
      },
      {
        "source": "/cv/academic/**",
        "destination": "/cv/research-full",
        "type": 301
      },
      {
        "source": "/cv/research-professional",
        "destination": "/cv/research-2p",
        "type": 301
      },
      {
        "source": "/cv/research-professional/**",
        "destination": "/cv/research-2p",
        "type": 301
      },
      {
        "source": "/cv/sde-long",
        "destination": "/cv/professional-full",
        "type": 301
      },
      {
        "source": "/cv/sde-long/**",
        "destination": "/cv/professional-full",
        "type": 301
      },
      {
        "source": "/pdfs/academic.pdf",
        "destination": "/pdfs/research-full.pdf",
        "type": 301
      },
      {
        "source": "/pdfs/research-professional.pdf",
        "destination": "/pdfs/research-2p.pdf",
        "type": 301
      },
      {
        "source": "/pdfs/sde-long.pdf",
        "destination": "/pdfs/professional-full.pdf",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
