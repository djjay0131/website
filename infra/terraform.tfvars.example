# Copy to terraform.tfvars (git-ignored) and fill in. Never commit the copy.

# The project you created by hand (design doc §10 Q2).
project_id = "cusati-hub"

# Your Cloud Billing account ID: `gcloud billing accounts list`.
billing_account = "000000-000000-000000"

# Defaults, shown for reference; uncomment only to change.
# region                     = "us-east1"
# domain                     = "jason.cusati.us"        # canonical hub host (ADR-0006)
# redirect_domains           = ["research.cusati.us"]   # 301 to domain
# Never cusati.us or www.cusati.us: reserved for a family site (ADR-0006).
# github_repository          = "djjay0131/website"
# github_repository_id       = "1212933399"
# github_repository_owner_id = "5666389"
# hosting_site_id            = null # null = the project ID

# Phase 2. Both have working defaults; uncomment only to change.
#
# The content bucket. null = "<project_id>-content". Bucket names are globally
# unique, so override this if the default stem is already taken.
# content_bucket_name = null
#
# The satellites allowed to publish, keyed by SOURCE NAME. The key is the
# manifest's "source", the bucket prefix sources/<key>/ and the IAM condition,
# all at once. Adding a satellite is one entry. Note the per-entry default
# branch: cv's is master (ADR-0008), phd-milestones' is main.
# satellites = {
#   cv = {
#     repository          = "djjay0131/cv"
#     repository_id       = "1211056144"
#     repository_owner_id = "5666389"
#     default_branch      = "master"
#   }
#   phd-milestones = {
#     repository          = "djjay0131/phd-milestones"
#     repository_id       = "1373915518"
#     repository_owner_id = "5666389"
#     default_branch      = "main"
#   }
# }

# Phase 3. All four have working defaults; uncomment only to change.
#
# The private bucket the gate serves from. null = "<project_id>-private".
# Globally unique, like the content bucket, so override if the stem is taken.
# private_bucket_name = null
#
# PERMANENT. A Firestore database's location cannot be changed after the
# database is created; changing this later means a second database and a
# migration. us-east1 matches the gate and both buckets.
# firestore_location = "us-east1"
#
# The gate's container image. The default is a PLACEHOLDER (Google's public
# sample container): .github/workflows/gate.yml pushes the real image and
# deploys it, and Terraform ignores changes to this field afterwards.
# gate_image = "us-docker.pkg.dev/cloudrun/container/hello"
#
# Cloud Run maximum instances for the gate. The minimum is fixed at 0 in code.
# gate_max_instance_count = 3
