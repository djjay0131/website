# Provider plugins and module cache (re-created by `terraform init`).
.terraform/

# State: never committed. It records resource IDs and the billing account.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Real variable values, including the billing account. Only
# terraform.tfvars.example is committed (it does not match these patterns).
*.tfvars
*.tfvars.json

# Saved plans embed variable values.
*.tfplan
tfplan

# Local overrides and crash logs.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# firebase-tools installed by `npm ci --prefix infra/deploy-tools`. Its
# package.json and package-lock.json are committed.
deploy-tools/node_modules/

# .terraform.lock.hcl is intentionally NOT ignored.
